o {merchantName}\",\"payment.success_state.description\":\"A payment to {merchantName} will appear on your statement.\",\"payment.success_state.description.with_trial\":\"After your trial, a payment to {statementDescriptor} will appear on your statement.\",\"payment.success_state.description.without_trial\":\"A payment to {statementDescriptor} will appear on your statement.\",\"payment.success_state.download_invoice\":\"Download invoice\",\"payment.success_state.download_receipt\":\"Download receipt\",\"payment.success_state.footer\":\"You’ll be redirected back to {merchantName} in {count} seconds.\",\"payment.success_state.header\":\"Payment succeeded\",\"payment.success_state.header.donation\":\"Thanks for your donation\",\"payment.success_state.header.one_time\":\"Thanks for your payment\",\"payment.success_state.header.one_time_free\":\"Thanks for your order\",\"payment.success_state.header.subscription\":\"Thanks for subscribing\",\"payment.success_state.header.setup\":\"Payment information saved\",\"payment.terms_of_service_consent.error\":\"Agree to {business_name}\\'s terms to complete your transaction.\",\"payment.terms_of_service_consent.error_no_business_name\":\"Agree to the terms to complete your transaction.\",\"payment.terms_of_service_consent.privacy_policy\":\"Privacy Policy\",\"payment.terms_of_service_consent.terms_of_service\":\"Terms of Service\",\"payment.terms_of_service_consent.terms_of_service_and_privacy_policy\":\"I agree to {business_name}\\'s {terms_of_service_link} and {privacy_policy_link}\",\"payment.terms_of_service_consent.terms_of_service_and_privacy_policy_no_business_name\":\"I agree to the {terms_of_service_link} and {privacy_policy_link}\",\"payment.terms_of_service_consent.terms_of_service_confirmation\":\"I agree to {business_name}\\'s {terms_of_service_link}.\",\"payment.terms_of_service_consent.terms_of_service_confirmation_no_business_name\":\"I agree to the {terms_of_service_link}.\",\"payment.upi.await_auth.cancel\":\"Cancel and pay another way\",\"payment.upi.await_auth.description\":\"You should have received a notification on your phone to authenticate this payment. Open your UPI app to complete the payment.\",\"payment.upi.label.bank\":\"Virtual Payment Address (VPA)\",\"payment.upi.label.vpa\":\"Virtual Payment Address (VPA)\",\"payment.upi.placeholder.vpa\":\"your.name@somebank\",\"payment.us_bank_account.connections.mandate_terms\":\"By clicking ‘{ctaText}’ you agree to authorize payments pursuant to {mandateTermsLink}.\",\"payment.us_bank_account.connections.mandate_terms_link\":\"these terms\",\"payment.us_bank_account.connections.mandate_terms_with_link\":\"By clicking ‘{ctaText}’ you agree to authorize payments pursuant to <a>these terms</a>.\",\"payment.us_bank_account.connections.consent_authorization.ownership\":\"{business_name} can access account and ownership details. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.balances\":\"{business_name} can access account details and balances. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.transactions\":\"{business_name} can access account details and transactions. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.ownership_balances\":\"{business_name} can access account and ownership details and balances. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.ownership_transactions\":\"{business_name} can access account and ownership details and transactions. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.balances_transactions\":\"{business_name} can access account details, balances, and transactions. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.consent_authorization.ownership_balances_transactions\":\"{business_name} can access account and ownership details, balances, and transactions. <learn_more_link>Learn more</learn_more_link>\",\"payment.us_bank_account.connections.payment\":\"Another step will appear after submitting your order to complete your payment details.\",\"payment.us_bank_account.connections.secured_by_stripe\":\"Secured by Stripe\",\"payment.us_bank_account.connections.setup\":\"Another step will appear after clicking setup to continue saving your payment details.\",\"payment.us_bank_account.connections_bank_picker.label.institution_search\":\"Bank account\",\"payment.us_bank_account.connections_bank_picker.manual_entry\":\"{manualEntryLink} (may take 1-2 business days)\",\"payment.us_bank_account.connections_bank_picker.manual_entry_link\":\"Enter bank details manually\",\"payment.us_bank_account.connections_bank_picker.manual_entry_link_2\":\"enter bank details manually\",\"payment.us_bank_account.connections_bank_picker.manual_entry_link_3\":\"enter bank details manually\",\"payment.us_bank_account.connections_bank_picker.manual_entry_no_delay\":\"Enter bank details manually\",\"payment.us_bank_account.connections_bank_picker.manual_entry_with_link\":\"<a>Enter bank details manually</a> (may take 1-2 business days)\",\"payment.us_bank_account.connections_bank_picker.no_banks_found\":\"No banks found. Check your spelling and try again, or {manualEntryLink2}.\",\"payment.us_bank_account.connections_bank_picker.no_banks_found_no_manual_entry\":\"No banks found. Please check your spelling and try again.\",\"payment.us_bank_account.connections_bank_picker.no_banks_found_with_link\":\"No banks found. Check your spelling and try again, or <a>enter bank details manually</a>.\",\"payment.us_bank_account.connections_bank_picker.manually_verify_subtitle_link\":\"manually enter details\",\"payment.us_bank_account.connections_bank_picker.no_banks_found_subtitle\":\"Try searching another bank or {textWithLink}.\",\"payment.us_bank_account.connections_bank_picker.no_banks_found_no_microdeposits_subtitle\":\"Try searching another bank\",\"payment.us_bank_account.connections_bank_picker.no_banks_found_heading\":\"No results\",\"payment.us_bank_account.connections_bank_picker.search_failed.heading\":\"Search is currently unavailable\",\"payment.us_bank_account.connections_bank_picker.search_failed.subtitle\":\"Please try again later\",\"payment.us_bank_account.connections_bank_picker.search_failed.subtitle_with_manual_entry\":\"Please try again later or {textWithLink}\",\"payment.us_bank_account.connections_bank_picker.search_results_footer\":\"Can’t find your bank? Check your spelling or {manualEntryLink3}.\",\"payment.us_bank_account.connections_bank_picker.search_results_footer_no_manual_entry\":\"Can’t find your bank? Please check your spelling and try again.\",\"payment.us_bank_account.connections_bank_picker.search_results_footer_with_link\":\"Can’t find your bank? Check your spelling or <a>enter bank details manually</a>.\",\"payment.us_bank_account.connections_bank_picker.search_unavailable\":\"Search is currently unavailable. Please try again, or {manualEntryLink2}.\",\"payment.us_bank_account.connections_bank_picker.search_unavailable_no_manual_entry\":\"Search is currently unavailable. Please try again later.\",\"payment.us_bank_account.connections_bank_picker.search_unavailable_with_link\":\"Search is currently unavailable. Please try again, or <a>enter bank details manually</a>.\",\"payment.us_bank_account.connections_bank_picker.searching\":\"Searching banks...\",\"payment.us_bank_account.full_instructions\":\"US bank debits, also known as ACH debits, can take up to 5 business days to process.\",\"payment.us_bank_account.label.billing_name\":\"Full name\",\"payment.us_bank_account.mandate\":\"By clicking Pay, you authorize {businessName} to debit the bank account specified for any amount owed for charges arising from your use of {businessName} services and/or purchase of products from {businessName}, pursuant to {businessName}\\'s website and terms, until this authorization is revoked. You may amend or cancel this authorization at any time by providing notice to the merchant with 30 (thirty) days notice.\",\"payment.us_bank_account.mandate_payment\":\"By clicking Confirm payment, you authorize {businessName} to debit the bank account specified for any amount owed for charges arising from your use of {businessName} services and/or purchase of products from {businessName}, pursuant to {businessName}\\'s website and terms, until this authorization is revoked. You may amend or cancel this authorization at any time by providing notice to the merchant with 30 (thirty) days notice.\",\"payment.us_bank_account.mandate_setup\":\"By clicking Confirm setup, you authorize {businessName} to debit the bank account specified for any amount owed for charges arising from your use of {businessName} services and/or purchase of products from {businessName}, pursuant to {businessName}\\'s website and terms, until this authorization is revoked. You may amend or cancel this authorization at any time by providing notice to the merchant with 30 (thirty) days notice.\",\"payment.us_bank_account.microdeposit_explanation.payment\":\"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to {businessName}.\",\"payment.us_bank_account.microdeposit_explanation.setup\":\"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete set up with {businessName}.\",\"payment.us_bank_account.microdeposit_explanation.subscription\":\"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete subscribing with {businessName}.\",\"payment.us_bank_account.microdeposit_explanation.trial\":\"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete setting up your trial with {businessName}.\",\"payment.us_bank_account.row.default_display_name\":\"Bank account\",\"payment.wechat_pay.await_auth.cancel\":\"Cancel and pay another way\",\"payment.wechat_pay.label.instructions\":\"Scan and pay with WeChat\",\"payment.wechat_pay.product_name\":\"WeChat Pay\",\"payment.wechat_pay.text.scanInstructions\":\"You will be shown a QR code to scan using WeChat Pay.\",\"payment.wero.product_name\":\"Wero\",\"payment_method_mandate.au_becs_debit\":\"By clicking {callToAction}, you agree to this Direct Debit Request and the {service_agreement_link}, and authorise Stripe Payments Australia Pty Ltd ACN 160 180 343 Direct Debit User ID number 507156 (“Stripe”) to debit your account through the Bulk Electronic Clearing System (BECS) on behalf of {businessName} (the “Merchant”) for payments as per the terms of your agreement with the Merchant. You certify that you are either an account holder or an authorised signatory on the account listed above.\",\"payment_method_mandate.cash_app\":\"By clicking {callToAction}, you authorize {businessName} to debit your Cash App account in accordance with {businessName}\\'s terms, until this authorization is revoked. You can change this anytime in your Cash App Settings.\",\"payment_method_mandate.link_default_opt_in.with_merchant_links\":\"By clicking {callToAction}, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"payment_method_mandate.link_default_opt_in.with_merchant_links.privacy_policy_only\":\"By clicking {callToAction}, you agree to our <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"payment_method_mandate.link_default_opt_in\":\"By clicking {callToAction}, you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"payment_method_mandate.link_default_opt_in.fireside\":\"By continuing with <LinkModalLink>Link</LinkModalLink>, you agree to the <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy</LinkPrivacyLink>.\",\"payment_method_mandate.link_default_opt_in_generic\":\"By continuing, you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"payment_method_mandate.link_instant_debit.terms_with_link\":\"By clicking {callToAction} you agree to authorize payments pursuant to <a>these terms</a>.\",\"payment_method_mandate.kr_market\":\"Your payment will be processed via NICEPAY in accordance with {terms_link}.\",\"payment_method_mandate.ng_card.terms.link_text\":\"their terms\",\"payment_method_mandate.ng_card.terms.text\":\"By continuing, you agree that your transaction will be handled by Global Stack Services Limited as merchant of record and in accordance with their terms of use. You consent to be charged for this payment and future payments in accordance with {terms_link}.\",\"payment_method_mandate.nz_bank_account.part1\":\"By providing your bank account details and confirming this payment, you authorise Stripe New Zealand Limited (authorisation code {directDebitAuthorityNumber}), to debit your account with the amounts of direct debits payable to {businessName} (”Merchant”) in accordance with this authority.\",\"payment_method_mandate.nz_bank_account.part1_xero\":\"By providing your bank account details and confirming this payment, you authorise {businessName} (”Merchant”), DDA authorisation code {directDebitAuthorityNumber}, to debit your account with the amounts of direct debits from Merchant in accordance with this authority.\",\"payment_method_mandate.nz_bank_account.part_1_and_2\":\"You agree that this authority is subject to both your bank’s terms and conditions that relate to your account and the {direct_debit_service_terms_and_conditions_url}\",\"payment_method_mandate.nz_bank_account.terms_url_anchor\":\"Direct Debit Service Terms & Conditions\",\"payment_method_mandate.nz_bank_account.part3\":\"You certify that you are either the sole account holder on the bank account listed above or that you are an authorised signatory on, and have authority to operate, this bank account severally.\",\"payment_method_mandate.nz_bank_account.part4\":\"We will send you an email confirmation no later than 5 business days after your confirmation of this Direct Debit Authority.\",\"payment_method_mandate.p24\":\"By clicking {callToAction}, you declare that you have familiarized yourself with the {regulations} and {information_obligation} of the Przelewy24 service.\",\"payment_method_mandate.sepa.citi\":\"By clicking {callToAction}, you authorise (A) {business_name} and Stripe, our payment service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. As part of your rights, you are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited. Your rights are explained in a statement that you can obtain from your bank. You agree to receive notifications for future debits up to 2 days before they occur.\",\"payment_method_manda.south_korea_market.\":\"Your payment will be processed via NICEPAY in accordance with {terms_link}.\",\"payment_method_mandate.south_korea_market\":\"Your payment will be processed via NICEPAY in accordance with {terms_link}.\",\"payment_method_mandate.us_bank_account.microdeposit_explanation\":\"Stripe will deposit $0.01 to your account in 1-2 business days. Then you\\'ll get an email with instructions to complete payment to {businessName}.\",\"payment_method_mandate.us_bank_account\":\"By clicking {callToAction} you agree to authorize payments pursuant to {mandateTermsLink}.\",\"placeholders.select\":\"Select...\",\"phone_number_collection.tooltip\":\"In case we need to contact you about your order.\",\"managed_payments.account_review.requires_dob.title\":\"Confirm your date of birth\",\"managed_payments.account_review.requires_dob.body\":\"We couldn\\'t log you in because we\\'ve been unable to confirm your date of birth.\",\"managed_payments.account_review.requires_dob.button\":\"Confirm date of birth\",\"managed_payments.account_review.requires_id.title\":\"Upload your photo ID\",\"managed_payments.account_review.requires_id.body\":\"We couldn\\'t log you in because we\\'ve been unable to confirm your identity. Upload your government-issued photo ID to continue.\",\"managed_payments.account_review.requires_id.button\":\"Finish account setup\",\"managed_payments.account_review.under_review.title\":\"We\\'re reviewing your account\",\"managed_payments.account_review.under_review.body\":\"We were unable to log you in because your account is under review. We\\'ll email you once we\\'ve confirmed your account or if we need additional information. If you have any questions, please visit our <SupportLink>support site</SupportLink>.\",\"managed_payments.account_review.under_review.button\":\"Return to {merchantName}\",\"managed_payments.account_review.deactivated.title\":\"Your account has been deactivated\",\"managed_payments.account_review.deactivated.body\":\"After review, we have deactivated your account. You will no longer be able to use your Link account. If you have any questions, please visit our <SupportLink>support site</SupportLink>.\",\"managed_payments.account_review.deactivated.button\":\"Return to {merchantName}\",\"managed_payments.require_link_login\":\"{cta} to continue\",\"managed_payments.require_link_login.cta\":\"Confirm it\\'s you\",\"managed_payments.link_login_email.cta\":\"Check your email\",\"managed_payments.link_login_sms.cta\":\"Check your text