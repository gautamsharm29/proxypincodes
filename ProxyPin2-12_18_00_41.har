tiered_rate.volume\":\"{previousTierUpTo}-{tierUpTo} {unitLabel}\",\"rate.tiered_rate.volume.last\":\"{previousTierUpTo}+ {unitLabel}\",\"rate.price_metered_unit_label\":\"{amount} {hasCustomPricingUnit, select, true {{customPricingUnit} } other {}}per {hasTransformQuantity, select, true {{transformQuantity} } other {}}{unitLabel}\",\"rate.price_metered_default_unit_label\":\"unit\",\"rate.price_metered_default_unit_label_plural\":\"units\",\"rate_card_subscription.metered_description.day.singular\":\"Usage prices billed daily\",\"rate_card_subscription.metered_description.week.singular\":\"Usage prices billed weekly\",\"rate_card_subscription.metered_description.month.singular\":\"Usage prices billed monthly\",\"rate_card_subscription.metered_description.year.singular\":\"Usage prices billed annually\",\"usage_billing_description.day.singular\":\"Usage billed daily\",\"usage_billing_description.week.singular\":\"Usage billed weekly\",\"usage_billing_description.month.singular\":\"Usage billed monthly\",\"usage_billing_description.year.singular\":\"Usage billed annually\",\"usage_billing_description.day.plural\":\"Usage billed every {count} days\",\"usage_billing_description.week.plural\":\"Usage billed every {count} weeks\",\"usage_billing_description.month.plural\":\"Usage billed every {count} months\",\"usage_billing_description.year.plural\":\"Usage billed every {count} years\",\"rate_card_subscription.open_all_rates_modal\":\"View all rates ({totalCount})\",\"rate_card_subscription.open_all_tiers_modal\":\"View all details\",\"rates.modal.header\":\"Rates\",\"rates.modal.rate_count\":\"{count, plural, one {{count} rate} other {{count} rates}}\",\"rates.modal.rate_count_with_more\":\"{count}+ rates\",\"setup.acss_debit.mandate\":\"By accepting this Agreement, you authorize {businessName} to debit the specified bank account for any amount owed for charges arising from the use of services and/or purchase of products.\",\"setup.acss_debit.notice_of_cancellation_right\":\"You may amend or cancel this authorization at any time by providing notice to the merchant with 30 (thirty) days notice. To obtain a sample cancellation form, or further information on cancelling a PAD agreement, please contact your financial institution or visit www.payments.ca.\",\"setup.acss_debit.notice_of_debit\":\"You will be notified of upcoming debits up to 1 (one) day before payments are collected.\",\"setup.acss_debit.notice_of_pad\":\"You will receive confirmation of this agreement at least 3 (three) days before the initial payment due date.\",\"setup.acss_debit.notice_of_right\":\"You have certain recourse rights if any debit does not comply with this agreement. For example, you have the right to receive reimbursement for any debit that is not authorized or is not consistent with this PAD Agreement. To obtain more information on your recourse rights, contact your financial institution or visit www.payments.ca.\",\"setup.acss_debit.schedule\":\"Payments will be debited from the specified account according to the following schedule: {intervalDescription}\",\"setup.acss_debit.schedule.sporadic\":\"Payments may be debited from the specified account only after your authorization is obtained.\",\"setup.acss_debit.sporadic_schedule\":\"Payments will be debited from the specified account according to the predetermined interval with {businessName}\",\"setup.au_becs_debit.mandate\":\"By clicking Set up direct debit, you agree to this Direct Debit Request and the {service_agreement_link}, and authorise Stripe Payments Australia Pty Ltd ACN 160 180 343 Direct Debit User ID number 507156 (“Stripe”) to debit your account through the Bulk Electronic Clearing System (BECS) on behalf of {businessName} (the “Merchant”) for payments as per the terms of your agreement with the Merchant. You certify that you are either an account holder or an authorised signatory on the account listed above.\",\"setup_future_usage.subscription.au_becs_debit.cta_mandate\":\"By clicking {callToAction}, you agree to this Direct Debit Request and the {service_agreement_link}, and authorise Stripe Payments Australia Pty Ltd ACN 160 180 343 Direct Debit User ID number 507156 (“Stripe”) to debit your account through the Bulk Electronic Clearing System (BECS) on behalf of {businessName} (the “Merchant”) for payments as per the terms of your agreement with the Merchant. You certify that you are either an account holder or an authorised signatory on the account listed above.\",\"setup.au_becs_debit.mandate_link\":\"Direct Debit Request service agreement\",\"setup.bacs_debit.prompt\":\"Set up Bacs Direct Debit\",\"setup.bacs_debit.prompt.confirm\":\"Confirm your Direct Debit details\",\"setup.bacs_debit.rules.confirmation.merchant_sun\":\"I understand that {sudn} has partnered with Stripe to collect Direct Debits on behalf of {sudn}. I confirm that I am the account holder and only person required to authorise debits from this account.\",\"setup.bacs_debit.rules.confirmation.stripe_sun\":\"I understand that Stripe will be collecting Direct Debits on behalf of {businessName} and confirm that I am the account holder and the only person required to authorise debits from this account.\",\"setup.bacs_debit.rules.confirmation_email\":\"An email will be sent to {customerEmail} within three business days to confirm the setup of this debit instruction.\",\"setup.bacs_debit.rules.guarantee\":\"Your payments are protected by the {direct_debit_guarantee_link}.\",\"setup.bacs_debit.rules.notice\":\"You will receive two days advance notice of any amount to be debited under this instruction. Payments will show as \\'\\'{sudn}\\'\\' on your bank statement. After you complete the setup, an email confirmation will be sent to {customerEmail} within three business days.\",\"setup.bacs_debit.rules.notice_of_debit\":\"Additionally, you will receive two days advance notice via email of any amount to be debited under this instruction. Payments will show as \\'\\'{sudn}\\'\\' on your bank statement.\",\"setup.card.mandate\":\"By saving your card information, you allow {businessName} to charge your card for future payments in accordance with their terms.\",\"setup.card.mandate.link_default_opt_in\":\"By saving your card information, you allow {businessName} to charge your card for future payments in accordance with their terms, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup.card.mandate.link_default_opt_in.with_merchant_links\":\"By saving your card information, you allow {businessName} to charge your card for future payments in accordance with our terms, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup.payment.mandate\":\"By saving your payment information, you allow {businessName} to charge you for future payments in accordance with their terms.\",\"setup.card.prompt\":\"Save card information\",\"setup.cashapp.mandate\":\"By continuing, you authorize {businessName} to debit your Cash App account for this payment and future payments in accordance with {businessName}\\'s terms, until this authorization is revoked. You can change this anytime in your Cash App Settings.\",\"setup.generic.mandate\":\"By continuing to {paymentMethod}, you allow {businessName} to charge your {paymentMethod} account for future payments in accordance with their terms.\",\"setup.multi.prompt\":\"Save payment information\",\"setup.paypal.mandate\":\"By continuing to PayPal, you allow {businessName} to charge your PayPal account for future payments in accordance with their terms.\",\"setup.sepa_debit.from_payment.mandate\":\"By providing your payment information and confirming this payment, you authorise (A) {business_name} and Stripe, our payment service provider and/or PPRO, its local service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. As part of your rights, you are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited. Your rights are explained in a statement that you can obtain from your bank. You agree to receive notifications for future debits up to 2 days before they occur.\",\"setup.sepa_debit.from_payment.mandate.citi\":\"By providing your payment information and confirming this payment, you authorise (A) {business_name} and Stripe, our payment service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. As part of your rights, you are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited. Your rights are explained in a statement that you can obtain from your bank. You agree to receive notifications for future debits up to 2 days before they occur.\",\"setup.sepa_debit.subscription.mandate.citi\":\"By clicking {callToAction}, you authorise (A) {business_name} and Stripe, our payment service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. As part of your rights, you are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited. Your rights are explained in a statement that you can obtain from your bank. You agree to receive notifications for future debits up to 2 days before they occur.\",\"setup.sepa_debit.mandate\":\"By providing your IBAN and confirming this payment, you authorise (A) {businessName} and Stripe, our payment service provider and/or PPRO, its local service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. You are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited.\",\"setup.sepa_debit.mandate.citi\":\"By providing your IBAN and confirming this payment, you authorise (A) {businessName} and Stripe, our payment service provider, to send instructions to your bank to debit your account and (B) your bank to debit your account in accordance with those instructions. You are entitled to a refund from your bank under the terms and conditions of your agreement with your bank. A refund must be claimed within 8 weeks starting from the date on which your account was debited.\",\"setup_future_usage.donation.card.mandate\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and future payments in accordance with their terms.\",\"setup_future_usage.donation.card.mandate.link_default_opt_in\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and future payments in accordance with their terms, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.donation.card.mandate.link_default_opt_in.with_merchant_links\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and future payments in accordance with our terms, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.donation.card.mandate.on_session\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and save payment information in accordance with their terms.\",\"setup_future_usage.metered_subscription.card.mandate.link_default_opt_in.with_merchant_links\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel. You also agree to the <MerchantTermsLink>Terms of Service</MerchantTermsLink>, <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.donation.card.mandate.on_session.link_default_opt_in\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and save payment information in accordance with their terms, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.donation.card.mandate.on_session.link_default_opt_in.with_merchant_links\":\"By confirming your donation, you allow {businessName} to charge your card for this payment and save payment information in accordance with our terms, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.metered_subscription.card.mandate\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel.\",\"setup_future_usage.metered_subscription.card.mandate.link_default_opt_in\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel. You also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.metered_subscription.card.cta_mandate.link_default_opt_in\":\"By clicking {callToAction}, you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.metered_subscription.card.cta_mandate.link_default_opt_in_generic\":\"By continuing, you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.metered_subscription.card.cta_mandate.link_default_opt_in.with_merchant_links\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel. You also agree to the <MerchantTermsLink>Terms of Service</MerchantTermsLink>, <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.payment.on_session.mandate\":\"By confirming your payment, you allow {businessName} to charge you for this payment and save your payment information in accordance with their terms.\",\"setup_future_usage.payment.off_session.mandate\":\"By confirming your payment, you allow {businessName} to charge you for this payment and future payments in accordance with their terms.\",\"setup_future_usage.payment.card.mandate\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and future payments in accordance with their terms.\",\"setup_future_usage.payment.card.mandate.link_default_opt_in\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and future payments in accordance with their terms, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.payment.card.mandate.link_default_opt_in.with_merchant_links\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and future payments in accordance with our terms, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.payment.card.mandate.on_session\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and save payment information in accordance with their terms.\",\"setup_future_usage.payment.card.mandate.on_session.link_default_opt_in\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and save payment information in accordance with their terms, and you also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.payment.card.mandate.on_session.link_default_opt_in.with_merchant_links\":\"By confirming your payment, you allow {businessName} to charge your card for this payment and save payment information in accordance with our terms, you agree to our <MerchantTermsLink>Terms of Service</MerchantTermsLink> and <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and you also to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.payment.generic.mandate\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel.\",\"setup_future_usage.payment.paypal.mandate\":\"By confirming your payment with PayPal, you allow {businessName} to charge your PayPal account for future payments in accordance with their terms.\",\"setup_future_usage.subscription.card.mandate\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel.\",\"setup_future_usage.subscription.card.mandate.link_default_opt_in\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel. You also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.card.mandate.link_default_opt_in.with_merchant_links\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel. You also agree to the <MerchantTermsLink>Terms of Service</MerchantTermsLink>, <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.card.cta_mandate.link_default_opt_in\":\"You also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.card.cta_mandate.link_default_opt_in_generic\":\"You also agree to the Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.card.cta_mandate.link_default_opt_in.with_merchant_links\":\"You also agree to the <MerchantTermsLink>Terms of Service</MerchantTermsLink>, <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.card.cta_mandate.link_default_opt_in.with_merchant_links.privacy_policy_only\":\"You also agree to the <MerchantPrivacyLink>Privacy Policy</MerchantPrivacyLink>, and Link <LinkTermsLink>Terms</LinkTermsLink> and <LinkPrivacyLink>Privacy Policy</LinkPrivacyLink>.\",\"setup_future_usage.subscription.generic.mandate\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel.\",\"setup_future_usage.subscription.paypal.mandate\":\"By subscribing, you authorize {businessName} to charge you according to the terms until you cancel.\",\"setup_future_usage.subscription.mandate\":\"By subscribing, you authorize {merchantName} to charge you according to the terms until you cancel.\",\"setup_future_usage.subscription.mandate.managed_payments\":\"By placing your order, you authorize {merchantOfRecordBusinessName} to charge you in accordance with its terms for the {businessName} product sold through {merchantOfRecordBusinessName} and subject to {businessName} terms.\",\"sheet.close\":\"Close\",\"sheet.mobile_order_details_sheet.title\":\"Order summary\",\"stripepass.account_form.change\":\"Change\",\"stripepass.account_form.email_suggestion\":\"Did you mean {email}?\",\"stripepass.account_form.log_in\":\"Continue with Link\",\"stripepass.account_form.log_out\":\"Log out\",\"stripepass.account_form.log_out_modal.cancel\":\"Cancel\",\"stripepass.account_form.log_out_modal.headline\":\"Log out?\",\"stripepass.account_form.log_out_modal.info\":\"This will log out <b>“{email}”</b> and remove your Link checkout information from this device. You can always log back in by using the same email.\",\"stripepass.account_form.log_out_modal.info_new\":\"This will log you out and remove your Link checkout information from this device. You can always log back in by using your email.\",\"stripepass.account_form.log_out_modal.info_managed_payments\":\"You won’t be able to complete this purchase unless you log back in.\",\"stripepass.account_form.saved_info\":\"Saved payment information\",\"stripepass.account_form.section.contact_information\":\"Contact\",\"stripepass.account_form.section.email\":\"Email\",\"stripepass.account_form.section.payment\":\"Pay with\",\"stripepass.account_form.section.phone_description\":\"Enter phone number\",\"stripepass.account_form.section.shipping\":\"Ship to\",\"stripepass.info.cash_back\":\"Get {amount} cash back\",\"stripepass.info.cash_back.description\":\"Save your info with Link and you’ll get {amount} cash back sent to your payment account within 2 days.\",\"stripepass.info.close\":\"Close\",\"stripepass.info.headline\":\"{businessName} uses Link to securely save your payment information.\",\"stripepass.info.links.privacy\":\"Learn more about privacy\",\"stripepass.info.mobile_verification\":\"Mobile verification\",\"stripepass.info.mobile_verification.description\":\"You’re protected with mobile authentication designed to ensure that you’re the only person who can access your information.\",\"stripepass.info.notice\":\"You can review every order before you pay.\",\"stripepass.info.security\":\"Data encryption\",\"stripepass.info.security.description\":\"Your card information stays secure with data encryption on servers that meet the highest PCI standards available in the payment industry.\",\"stripepass.info.subheadline\":\"Link autofills your contact information, card details, and shipping addresses for future purchases on Link-supported sites.\",\"stripepass.verification.api_error\":\"Sorry — something went wrong while verifying your code.\",\"stripepass.verification.cancel\":\"Cancel\",\"stripepass.verification.email_otp_code_resent\":\"Code sent, please check your email.\",\"stripepass.verification.enter_code\":\"Enter the code sent to {factor}\",\"stripepass.verification.enter_code_explanation\":\"Enter the verification code we sent to your phone to use your payment information you saved during a previous purchase.\",\"stripepass.verification.enter_email_code_explanation\":\"Enter the 6-digit code we sent to your email to use your payment information you saved during a previous purchase.\",\"stripepass.verification.enter_sms_code_explanation\":\"Enter the 6-digit code we sent to your phone to use your payment information you saved during a previous purchase.\",\"stripepass.verification.expired_session\":\"This code expired—check your phone for the new code.\",\"stripepass.verification.expired_session_email\":\"This code expired—check your email for the new code.\",\"stripepass.verification.generic_error\":\"Sorry — something went wrong while verifying your code. Please try again in a few minutes.\",\"stripepass.verification.get_webauthn_credential_generic_error\":\"There was an issue logging in with your passkey.\",\"stripepass.verification.invalid_code\":\"This code didn’t work—check the numbers and try again.\",\"stripepass.verification.log_in\":\"Log in as {email}\",\"stripepass.verification.log_out_info\":\"You won’t need to authenticate again on this device unless you log out.\",\"stripepass.verification.max_attempts_exceeded\":\"Too many failed attempts—wait a few minutes and try again.\",\"stripepass.verification.phone_number_verification.action\":\"Verify\",\"stripepass.verification.phone_number_verification.body\":\"Before we can send a code to your email, we need to verify additional information about you. Please enter your phone number ending in {phoneNumber}.\",\"stripepass.verification.phone_number_verification.exit\":\"Back\",\"stripepass.verification.phone_number_verification.headline\":\"Verify your phone number\",\"stripepass.verification.phone_number_verification.placeholder\":\"Phone number\",\"stripepass.verification.resend_email_otp_code\":\"Resend code\",\"stripepass.verification.review\":\"You can review your order before you pay.\",\"stripepass.verification.secure\":\"Secure\",\"stripepass.verification.send_code_instead\":\"Send code instead\",\"stripepass.verification.sending\":\"Sending\",\"stripepass.verification.sent_to\":\"Code sent to: {number}\",\"stripepass.verification.start_verification_generic_error\":\"Sorry — something went wrong. Please try again in a few minutes.\",\"stripepass.verification.start_verification_rate_limit_error\":\"Sorry — something went wrong.\",\"stripepass.verification.success\":\"Success\",\"stripepass.verification.use_a_passkey\":\"Use a passkey\",\"stripepass.verification.use_email_otp\":\"Send code to email instead\",\"stripepass.verification.use_info_headline\":\"Use your saved information\",\"stripepass.verification.use_sms_otp\":\"Text a code to {redactedPhoneNumber}\",\"stripepass.verification.use_web