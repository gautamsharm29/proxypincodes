crypto_onramp.crypto.onramp.app.wallet_connection_connecting\":\"Wallet connecting\",\"crypto_onramp.crypto.onramp.app.wallet_registration_error\":\"Unable to register your wallet: {fullErrorMessage}\",\"crypto_onramp.crypto.onramp.app.wallet_validation_could_not_resolve_address\":\"Could not resolve {walletAddress}\",\"crypto_onramp.crypto.onramp.app.wallet_validation_invalid_address\":\"Please enter a valid {network} wallet address.\",\"crypto_onramp.crypto.onramp.app.wallet_validation_resolving_address\":\"Resolving {walletAddress}\",\"crypto_onramp.crypto.onramp.app.wallet_validation_unsupported_bonfida\":\"Sorry, Bonfida addresses are not supported at this time. Please paste your full public address.\",\"crypto_onramp.crypto.onramp.app.wallet_validation_valid\":\"Valid wallet\",\"crypto_onramp.crypto.onramp.app.wallet_validation_valid_with_address\":\"Valid wallet: {walletAddress}\",\"crypto_onramp.crypto.onramp.app.we_sent_you_an_email\":\"We sent you an email\",\"crypto_onramp.crypto.onramp.app.web_authentication.device_hardware_authentication_note\":\"You’ll be prompted to use your device’s hardware authentication.\",\"crypto_onramp.crypto.onramp.app.web_authentication.device_verified\":\"Device verified\",\"crypto_onramp.crypto.onramp.app.web_authentication.errors.could_not_authenticate\":\"Link could not authenticate your device. Please try again.\",\"crypto_onramp.crypto.onramp.app.web_authentication.errors.could_not_verify\":\"Your device could not be verified. Please try again\",\"crypto_onramp.crypto.onramp.app.web_authentication.errors.failed_to_retrieve_challenge\":\"Failed to retrieve web authentication challenge.\",\"crypto_onramp.crypto.onramp.app.web_authentication.verification_rationale\":\"By verifying your device, Link can better protect your information from being accessed or misused by any third parties.\",\"crypto_onramp.crypto.onramp.app.web_authentication.verify_my_device\":\"Verify my device\",\"crypto_onramp.crypto.onramp.app.web_authentication.verify_your_device\":\"Verify your device\",\"crypto_onramp.crypto.onramp.app.web_authentication.verify_your_device_to_log_in\":\"Verify your device to log in\",\"crypto_onramp.crypto.onramp.app.web_authentication.verifying_your_device\":\"Verifying your device...\",\"crypto_onramp.crypto.onramp.app.whats_required\":\"What’s required:\",\"crypto_onramp.crypto.onramp.app.why_required\":\"Why is this information required\",\"crypto_onramp.crypto.onramp.app.yes_remove\":\"Yes, remove\",\"crypto_onramp.crypto.onramp.app.your_identity_is_being_verified\":\"Your identity is being verified. This should only take a moment.\",\"crypto_onramp.crypto.onramp.app.your_identity_is_being_verified_email\":\"Your identity is being verified. We’ll email you as soon as it’s complete to finish your order. This can take up to 2 minutes.\",\"crypto_onramp.crypto.onrmap.app.partner_terms\":\"Cryptocurrency Services powered by Zero Hash. By clicking pay you agree to the Zero Hash and Zero Hash Liquidity Services <UserAgreementLink>User Agreement</UserAgreementLink>, and you acknowledge you have read and understand the Zero Hash <PrivacyPolicyLink>Privacy Policy</PrivacyPolicyLink> and <RegulatoryDisclosuresLink>Regulatory Disclosures</RegulatoryDisclosuresLink>. You understand that the value of any cryptocurrency, including digital assets pegged to fiat currency, commodities, or any other asset, may go to zero. Orders may not be canceled or reversed once submitted by you. By submitting a withdrawal request, you are requesting an on-chain transaction that is not reversible or recallable. You are responsible for reviewing the recipient address and ensuring it is the correct address for the selected address for withdrawal.\",\"disclosures.financialAccount.fdicDisclosure\":\"Accounts are eligible for FDIC pass-through deposit insurance if they meet certain requirements, only to the extent pass-through insurance is permitted by the rules and regulations of the FDIC, and if the requirements for pass-through insurance are satisfied. The FDIC insurance applies up to $250,000 USD per depositor, per financial institution, for deposits held in the same type of account. Neither Stripe nor {platformName} is an FDIC-insured institution. The FDIC’s deposit insurance coverage only protects against the failure of an FDIC-insured depository institution.\",\"disclosures.financialAccount.stripeAndBankPartnersDisclosure\":\"{platformName} partners with {stripeLink} for money transmission services and account services with funds held at {bankingPartnersList}, {numberOfPartners, plural, one {Member} other {Members}} FDIC.\",\"disclosures.issuing.disclosure\":\"{userCardProgramName} {cardNetworkBrand} Commercial cards are powered by Stripe and issued by {issuingPartner}.\",\"disclosures.learnMoreLink\":\"Learn more\",\"display_bank_transfer_instructions.voucher_frame_title\":\"Bank Transfer Instructions\",\"easel.aria.back\":\"Back\",\"easel.aria.message.expand\":\"Expand message\",\"easel.aria.message.collapse\":\"Collapse message\",\"easel.aria.position.bottom_left\":\"Position: Bottom left\",\"easel.aria.position.bottom_right\":\"Position: Bottom right\",\"easel.aria.position.top_left\":\"Position: Top left\",\"easel.aria.position.top_right\":\"Position: Top right\",\"easel.aria.stripe_dev_tools.open\":\"Open Stripe Developer Tools\",\"easel.aria.stripe_dev_tools.close\":\"Close Stripe Developer Tools\",\"easel.aria.tab_label.inbox\":\"Inbox\",\"easel.aria.tab_label.settings\":\"Settings\",\"easel.aria.tab_label.test\":\"Test\",\"easel.aria.view_errors\":\"View Errors\",\"easel.badge.new\":\"New\",\"easel.developers\":\"Developers\",\"easel.docs\":\"Docs\",\"easel.link\":\"Link\",\"easel.elements_inspector.adaptive_pricing\":\"Adaptive pricing\",\"easel.elements_inspector.adaptive_pricing.customer_currency_not_supported\":\"Adaptive Pricing is not available in {country}.\",\"easel.elements_inspector.adaptive_pricing.integration_currency_is_not_a_merchant_settlement_currency\":\"Adaptive Pricing is disabled because <code>{currency}</code> is not one of your settlement currencies. To use Adaptive Pricing, the currency for your prices must be one of your settlement currencies.\",\"easel.elements_inspector.adaptive_pricing.customer_not_cross_border\":\"No price localization for local customers. Update customer country above to test Adaptive Pricing.\",\"easel.elements_inspector.adaptive_pricing.disabled_in_dashboard\":\"Enable Adaptive Pricing\",\"easel.elements_inspector.adaptive_pricing.disabled_in_api\":\"Adaptive Pricing is disabled on your Checkout Session.\",\"easel.elements_inspector.adaptive_pricing.integration_total\":\"Integration total price\",\"easel.elements_inspector.adaptive_pricing.integration_total_no_amount\":\"Integration currency\",\"easel.elements_inspector.adaptive_pricing.integration_total.selected\":\"Integration total price (selected)\",\"easel.elements_inspector.adaptive_pricing.integration_total_no_amount.selected\":\"Integration currency (selected)\",\"easel.elements_inspector.adaptive_pricing.not_allowed_for_ui\":\"Adaptive Pricing is not allowed on the client. Set <code>adaptivePricing.allowed</code> in your initCheckout options.\",\"easel.elements_inspector.adaptive_pricing.other\":\"Adaptive Pricing is disabled.\",\"easel.elements_inspector.adaptive_pricing.presentment_total\":\"Presentment total price\",\"easel.elements_inspector.adaptive_pricing.presentment_total.selected\":\"Presentment total price (selected)\",\"easel.elements_inspector.adaptive_pricing.status.active\":\"Active\",\"easel.elements_inspector.adaptive_pricing.status.disabled\":\"Disabled\",\"easel.elements_inspector.adaptive_pricing.status.inactive\":\"Inactive\",\"easel.elements_inspector.adaptive_pricing.status.unavailable\":\"Unavailable\",\"easel.elements_inspector.configure_payment_methods\":\"Enable and configure payment methods in the Dashboard.\",\"easel.elements_inspector.configure_payment_methods.link\":\"Payment method settings\",\"easel.elements_inspector.adaptive_pricing.presentment_no_amount\":\"Presentment currency\",\"easel.elements_inspector.adaptive_pricing.presentment_no_amount.selected\":\"Presentment currency (selected)\",\"easel.elements_inspector.displayed_payment_methods\":\"Displayed payment methods\",\"easel.elements_inspector.payment_config\":\"Payment configuration\",\"easel.elements_inspector.payment_config.config_id\":\"Configuration ID\",\"easel.elements_inspector.payment_config.config_id.copied\":\"Payment configuration ID copied to clipboard\",\"easel.elements_inspector.payment_config.config_id.copy\":\"Copy Configuration ID: {copyValue}\",\"easel.elements_inspector.payment_config.config_name\":\"Configuration name\",\"easel.elements_inspector.payment_config.dynamic\":\"Dynamic\",\"easel.elements_inspector.payment_config.manual_payment_method_types\":\"You\\'re using <code>payment_method_types</code> to manually choose payment methods.\",\"easel.elements_inspector.payment_config.details_not_found\":\"Payment method configuration details not found.\",\"easel.elements_inspector.unavailable_payment_methods\":\"Unavailable payment methods\",\"easel.elements_inspector.ece.methods.amazon_pay\":\"Amazon Pay\",\"easel.elements_inspector.ece.methods.apple_pay\":\"Apple Pay\",\"easel.elements_inspector.ece.methods.demo_pay\":\"Demo Pay\",\"easel.elements_inspector.ece.methods.google_pay\":\"Google Pay\",\"easel.elements_inspector.ece.methods.klarna\":\"Klarna\",\"easel.elements_inspector.ece.methods.link\":\"Link\",\"easel.elements_inspector.ece.methods.paypal\":\"PayPal\",\"easel.elements_inspector.ece.methods.shop_pay\":\"Shop Pay\",\"easel.elements_inspector.filtering_messages.affirm_amount_too_large\":\"Amount is too large to show Affirm as a payment method.\",\"easel.elements_inspector.filtering_messages.affirm_amount_too_small\":\"Amount is too small to show Affirm as a payment method.\",\"easel.elements_inspector.filtering_messages.amazon_pay_ece_unsupported_currency\":\"Amazon Pay is not supported with the current currency ({currency}).\",\"easel.elements_inspector.filtering_messages.api_version_mismatch\":\"This payment method is not supported with the given API version.\",\"easel.elements_inspector.filtering_messages.apple_pay_can_make_payments_with_active_card_returned_false\":\"Either Apple Pay is not supported on this device or browser, or there is not an active card in your Apple Pay wallet.\",\"easel.elements_inspector.filtering_messages.apple_pay_disabled_for_connected_accounts_with_no_dashboard_access_or_business_url\":\"Apple Pay is not available for Connected Accounts without Dashboard access or business URL.\",\"easel.elements_inspector.filtering_messages.apple_pay_session_available\":\"Google Pay is not supported in this browser.\",\"easel.elements_inspector.filtering_messages.apple_pay_session_not_available\":\"Apple Pay is not available in this browser.\",\"easel.elements_inspector.filtering_messages.apple_pay_version_not_supported\":\"This version of Safari does not meet the requirements to display Apple Pay. Please update your browser.\",\"easel.elements_inspector.filtering_messages.automatic_currency_conversion\":\"This payment method is not supported with Adaptive Pricing.\",\"easel.elements_inspector.filtering_messages.automatic_tax\":\"This payment method is not supported with automatic taxes.\",\"easel.elements_inspector.filtering_messages.automatic_taxes_address_source_session_shipping_address_not_required\":\"This payment method requires shipping address collection when automatic taxes are enabled. Enable shipping address collection or disable automatic taxes to use this payment method.\",\"easel.elements_inspector.filtering_messages.billing_address_collection_required\":\"This payment method is not supported with automatic taxes when billing address collection is required.\",\"easel.elements_inspector.filtering_messages.billing_address_dynamic_tax\":\"This payment method is not supported with dynamic taxes when billing address collection is required.\",\"easel.elements_inspector.filtering_messages.business_name_collection_required\":\"This payment method is not supported when business name collection is required.\",\"easel.elements_inspector.filtering_messages.custom_fields\":\"This payment method is not supported with custom fields.\",\"easel.elements_inspector.filtering_messages.customer_country\":\"This payment method is not supported with the buyer\\'s country.\",\"easel.elements_inspector.filtering_messages.customer_saved_payment_method\":\"This payment method is not supported when the buyer has a saved payment method.\",\"easel.elements_inspector.filtering_messages.customer_user_agent\":\"Link does not show as an Express Checkout option when using Internet Explorer.\",\"easel.elements_inspector.filtering_messages.charge_automatically_not_supported\":\"Payment method does not support <code>collection_method=charge_automatically</code>.\",\"easel.elements_inspector.filtering_messages.charge_exceeds_transaction_limit\":\"Amount exceeds the transaction limit for `{paymentMethodName}`. Please contact Stripe support if you\\'d like to increase this limit.\",\"easel.elements_inspector.filtering_messages.checkout_session_mandate_options_required_for_pm\":\"The payment method <code>{paymentMethodName}</code> requires <code>payment_method_options[{paymentMethodName}][mandate_options]</code> to be set on the Checkout Session.\",\"easel.elements_inspector.filtering_messages.checkout_session_invalid_currency_for_pm\":\"This payment method is not supported in the currency <currency>.\",\"easel.elements_inspector.filtering_messages.checkout_session_mode_unsupported_for_pm\":\"This payment method is not supported in the current mode.\",\"easel.elements_inspector.filtering_messages.checkout_session_no_eligible_shipping_countries_for_pm\":\"This payment method is not eligible for any of the allowed countries set in `shipping_address_collection`.\",\"easel.elements_inspector.filtering_messages.checkout_session_on_behalf_of_unsupported_for_pm\":\"<code>on_behalf_of</code> cannot be used with the <code>{paymentMethod}</code> payment method.\",\"easel.elements_inspector.filtering_messages.checkout_session_orchestration_incompatible_with_pm\":\"The parameter <code>custom_payment_method_types</code> cannot be used with this payment method. \",\"easel.elements_inspector.filtering_messages.checkout_session_setup_future_usage_off_session_required_for_pm\":\"This payment method requires <code>payment_intent_data[setup_future_usage]</code> to be set to <code>off_session</code>.\",\"easel.elements_inspector.filtering_messages.checkout_session_setup_future_usage_unsupported_for_pm\":\"<code>payment_intent_data.setup_future_usage</code> is unsupported for this payment method.\",\"easel.elements_inspector.filtering_messages.cross_origin_frame_and_browser_not_supported\":\"Apple Pay is not supported in a cross-origin iframe when the browser (Safari <17) doesn\\'t allow it or we can\\'t determine the parent origin.\",\"easel.elements_inspector.filtering_messages.domain_unregistered\":\"The current domain is not registered.\",\"easel.elements_inspector.filtering_messages.domain_not_registered\":\"This payment method requires your domain to be registered in the <pmcLink>Stripe Dashboard</pmcLink>.\",\"easel.elements_inspector.filtering_messages.disallowed_by_wallet_config\":\"This payment method isn\\'t enabled for your account. You may need to register the domain in your <domainsLink>Stripe Dashboard</domainsLink>. Otherwise, contact <supportLink>Stripe support</supportLink> for assistance. \",\"easel.elements_inspector.filtering_messages.disallowed_card_brands_present\":\"Link does not show up as an Express Checkout option if Card Brand Filtering is enabled and <code>link</code> is not part of <code>payment_method_types</code>.\",\"easel.elements_inspector.filtering_messages.dynamic_payment_methods_capability_not_present\":\"This payment method is not available to you. If you are connected to a platform, they may need to request access on your behalf.\",\"easel.elements_inspector.filtering_messages.dynamic_payment_methods_invalid_buyer_country\":\"The customer\\'s country is outside the countries you can accept with this payment method for the provided currency {currency}.\",\"easel.elements_inspector.filtering_messages.dynamic_payment_methods_link_without_cards\":\"You cannot use Link when cards are disabled in your dashboard.\",\"easel.elements_inspector.filtering_messages.dynamic_payment_methods_paypal_unsupported_transaction\":\"The PayPal payment method does not support the current charge type.\",\"easel.elements_inspector.filtering_messages.embedded_checkout_redirect_opt_out\":\"This payment method is not supported for this session because <code>automatic_payment_methods[allow_redirects]</code> is set to <code>never</code>.\",\"easel.elements_inspector.filtering_messages.fallback\":\"This payment method isn\\'t available. <supportLink>Contact Stripe support for details</supportLink>.\",\"easel.elements_inspector.filtering_messages.field_not_provided_by_financial_partner\":\"{paymentMethod} is not supported when either billing address or phone number is required.\",\"easel.elements_inspector.filtering_messages.finnish_or_swedish_client_non_credit_payment_methods\":\"This payment method is not shown due to payment method regulations in <sweedenSupportLink>Sweden</sweedenSupportLink> and <finlandSupportLink>Finland</finlandSupportLink>.\",\"easel.elements_inspector.filtering_messages.giropay_deprecated\":\"Giropay has been deprecated.\",\"easel.elements_inspector.filtering_messages.google_pay_can_make_payment_returned_false_or_disallowed_by_wallet_config\":\"Google Pay is unavailable because either your browser doesn\\'t support it, you have no payment methods saved in your Google Pay wallet, or your domain is not registered in the Stripe Dashboard.\",\"easel.elements_inspector.filtering_messages.google_pay_automatic_taxes_address_source_session_shipping_address_not_required\":\"This payment method requires shipping address collection when automatic taxes are enabled. Enable shipping address collection or disable automatic taxes to use this payment method.\",\"easel.elements_inspector.filtering_messages.invalid_amount_too_large\":\"Amount exceeds the maximum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.invalid_amount_too_small\":\"Amount is less than the minimum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.invalid_charge_amount\":\"Amount is less than the minimum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.in_old_beta\":\"This wallet is unavailable because you\\'re enrolled in a deprecated Payment Element beta. Please upgrade your integration to enable wallet support.\",\"easel.elements_inspector.filtering_messages.is_checkout\":\"Cross-browser Apple Pay is not yet supported in Elements with the Checkout Session API.\",\"easel.elements_inspector.filtering_messages.link_disabled_in_session_by_merchant\":\"Link has been disabled for this session via the <code>wallet_options</code> configuration.\",\"easel.elements_inspector.filtering_messages.managed_payments_enabled\":\"This payment method is not supported for Managed Payments Checkout sessions.\",\"easel.elements_inspector.filtering_messages.manual_capture_method_not_supported\":\"This payment method type can only be used with Payment Intents that have <code>capture_method=automatic</code>.\",\"easel.elements_inspector.filtering_messages.manual_payment_method_creation_unsupported\":\"{paymentMethod} is not supported with manual payment method creation.\",\"easel.elements_inspector.filtering_messages.merchant_country\":\"This payment method isn\\'t available to merchants registered in {countryCode}.\",\"easel.elements_inspector.filtering_messages.merchant_disabled_link_in_session\":\"Link has been disabled for this Checkout Session through <code>wallet_options</code>.\",\"easel.elements_inspector.filtering_messages.merchant_disabled_pm\":\"The payment method is not enabled. You can enable the payment method in <pmcLink>your Dashboard</pmcLink>.\",\"easel.elements_inspector.filtering_messages.merchant_payment_method_param_config\":\"{paymentMethod} was hidden by setting <code>paymentMethods.{paymentMethodName}: \\\\\"never\\\\\"</code> in your Express Checkout Element options.\",\"easel.elements_inspector.filtering_messages.merchant_payment_methods_settings\":\"This payment method isn\\'t enabled. Go to your <pmcLink>payment method configuration</pmcLink> in the Dashboard to enable it.\",\"easel.elements_inspector.filtering_messages.merchant_txn_amt_max\":\"The transaction amount is greater than the maximum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.merchant_txn_amt_min\":\"The transaction amount is less than the minimum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.merchant_txn_country\":\"The buyer country is not one of your configured countries for this payment method.\",\"easel.elements_inspector.filtering_messages.merchant_txn_currency\":\"The currency provided is not one of your configured currencies for this payment method.\",\"easel.elements_inspector.filtering_messages.merchant_txn_product_surface\":\"Your targeting settings have disabled payments with this payment method in {surface}.\",\"easel.elements_inspector.filtering_messages.no_shipping_address_required_multiple_shipping_options\":\"This payment method requires shipping address collection when shipping options are enabled. Enable shipping address collection or disable shipping options to use this payment method.\",\"easel.elements_inspector.filtering_messages.not_https\":\"This wallet is only available over <code>https</code>.\",\"easel.elements_inspector.filtering_messages.not_supported_in_embedded_custom_checkout\":\"This payment method isn\\'t supported in Embedded Checkout.\",\"easel.elements_inspector.filtering_messages.partner_check_false\":\"This payment method is either not available on your device or browser, or you do not have a payment method in your {paymentMethod} wallet.\",\"easel.elements_inspector.filtering_messages.phone_number_collection\":\"This payment method is not supported with phone number collection.\",\"easel.elements_inspector.filtering_messages.payment_intent_amount_too_large\":\"Amount exceeds the maximum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.payment_intent_customer_balance_creation_missing_customer\":\"This payment method requires a customer to be passed on the Payment Intent or Checkout Session.\",\"easel.elements_inspector.filtering_messages.payment_intent_invalid_currency\":\"This payment method is not supported in the currency {currency}.\",\"easel.elements_inspector.filtering_messages.payment_intent_connect_not_supported\":\"This payment method is not supported with Connect.\",\"easel.elements_inspector.filtering_messages.payment_intent_invalid_settlement_merchant_country\":\"This payment method is not supported for payments settling in country {countryCode}\",\"easel.elements_inspector.filtering_messages.payment_intent_on_behalf_of_not_onboarded\":\"This payment method is not activated for the account specified in <code>on_behalf_of</code. You can only create testmode {paymentMethod} Payment Intents. <learnMoreLink>Learn more</learnMoreLink>.\",\"easel.elements_inspector.filtering_messages.payment_intent_on_behalf_of_unsupported_types\":\"This payment method type does not support <code>on_behalf_of</code>.\",\"easel.elements_inspector.filtering_messages.payment_intent_presentment_abstraction_unsupported_for_type\":\"This payment method type is not supported with presentment currency abstraction.\",\"easel.elements_inspector.filtering_messages.payment_method_in_excluded_payment_method_types\":\"This payment method was filtered out by <code>excluded_payment_method_types</code>.\",\"easel.elements_inspector.filtering_messages.payment_method_without_cards_excluded_payment_method_types\":\"You cannot use Link when cards are filtered out by <code>excluded_payment_method_types</code>.\",\"easel.elements_inspector.filtering_messages.paypal_recurring_shipping_unsupported\":\"Shipping address collection is not supported for PayPal recurring payments.\",\"easel.elements_inspector.filtering_messages.recurring_payment_with_shipping_required\":\"This payment method is not supported for recurring payments with shipping address collection.\",\"easel.elements_inspector.filtering_messages.redirect_optout_for_payment_method_requiring_redirect\":\"This payment method is not supported for this transaction because <code>automatic_payment_methods[allow_redirects]</code> is set to <code>never</code>. If you want to accept redirect-based payment methods, set <code>automatic_payment_methods[allow_redirects]</code> to <code>always</code> when creating Setup Intents or Payment Intents.\",\"easel.elements_inspector.filtering_messages.setup_future_usage\":\"This payment method is not supported with setup future usage.\",\"easel.elements_inspector.filtering_messages.setup_future_usage_not_supported\":\"This payment method doesn\\'t support the <code>setup_future_usage</code> value or Checkout Session <code>mode</code>.\",\"easel.elements_inspector.filtering_messages.setup_future_usage_unsupported\":\"{paymentMethod} does not support <code>setup_future_usage</code>.\",\"easel.elements_inspector.filtering_messages.setup_mode\":\"This payment method is not supported with <code>setup</code> mode Checkout sessions.\",\"easel.elements_inspector.filtering_messages.setup_intent_bacs_debit_mandate_creation_not_supported\":\"Your account isn\\'t configured to directly use SetupIntents to create Mandates for Bacs Direct Debits.\",\"easel.elements_inspector.filtering_messages.setup_intent_outbound_not_supported_for_type\":\"This payment method is not supported with the <code>outbound</code> flow_direction. Create a new Setup Intent with payment method type that supports <code>outbound</code> or exclude <code>outbound</code> from flow_directions.\",\"easel.elements_inspector.filtering_messages.setup_intent_sepa_generation_sepa_debit_not_enabled\":\"To confirm a Setup Intent with this payment method type, you must activate SEPA Direct Debit.\",\"easel.elements_inspector.filtering_messages.shipping_address_collection_required\":\"This payment method is not supported when shipping address collection is required.\",\"easel.elements_inspector.filtering_messages.shipping_address_provided\":\"PayPal does not show up as an Express Checkout option when a shipping address is provided.\",\"easel.elements_inspector.filtering_messages.shipping_details_update_permission_server_only\":\"This payment method is not supported with <code>checkout_session[permissions][update_shipping_details]=server_only</code>.\",\"easel.elements_inspector.filtering_messages.sole_payment_method\":\"PayPal does not show up as an Express Checkout option for <code>payment_method_types</code> provided with only <code>paypal</code>.\",\"easel.elements_inspector.filtering_messages.sources_maximum_amount\":\"Amount exceeds the maximum amount for this payment method.\",\"easel.elements_inspector.filtering_messages.subscription_mode\":\"This payment method is not supported when Checkout Session mode is <code>subscription</code>.\",\"easel.elements_inspector.filtering_messages.subscription_payment_method_type_is_not_supported_by_adaptive_pricing\":\"This payment method does not suppport Adaptive Pricing.\",\"easel.elements_inspector.filtering_messages.tax_id_collection_required\":\"This payment method is not supported when tax ID collection is required.\",\"easel.elements_inspector.filtering_messages.timeout\":\"{paymentMethod} request timed out. Try again or check your network connection.\",\"easel.elements_inspector.filtering_messages.unsupported_browser\":\"{paymentMethod} is not supported in this browser.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_chromium_edge\":\"Google Pay is not supported in Edge.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_missing_payment_request\":\"{paymentMethod} requires the PaymentRequest API, which does not exist in this browser.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_missing_payment_request_api\":\"Google Pay is not supported because the browser does not support the Payment Request API (<code>window.PaymentRequest</code> is not available).\",\"easel.elements_inspector.filtering_messages.unsupported_browser_not_chrome_webkit_firefox\":\"Google Pay is not supported in this browser.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_not_safari_or_ios\":\"Apple Pay is not supported in your browser and/or device.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_not_webkit_or_blink\":\"Google Pay is not supported in this browser.\",\"easel.elements_inspector.filtering_messages.unsupported_browser_safari\":\"The Google Pay button is not supported in Safari.\",\"easel.elements_inspector.filtering_messages.usage_not_supported\":\"{paymentMethod} doesn\\'t support <code>usage=off_session</code> for SetupIntents or Checkout Sessions in <code>setup</code> mode.\",\"easel.elements_inspector.filtering_messages.wallet_disallowed_from_options\":\"This wallet is disabled in the wallets config in your Payment Element options.\",\"easel.inbox.create_google_maps_api_key\":\"Create a Google Maps API key\",\"easel.inbox.dashboard_payment_methods\":\"Update your payment method preferences\",\"easel.inbox.heading.error\":\"Error\",\"easel.inbox.heading.warning\":\"Warning\",\"easel.inbox.heading.info\":\"Optimization\",\"easel.inbox.heading.success\":\"Success\",\"easel.inbox.message.stripe_js_initialization_deferred\":\"The Stripe.js SDK is required to render the Payment Element and securely collect payment details. For optimal latency, load the script and initialize the Stripe.js constructor early in the user\\'s session to prevent the script from blocking rendering.\",\"easel.inbox.message.multiple_stripe_js_instances\":\"Creating multiple instances of the Stripe.js constructor within a single user session can hinder the performance of the Payment Element and your site. If using the same publishable key, create and share a single instance with a singleton pattern. In single-page applications, it is safe and recommended to share the Stripe.js instance across pages.\",\"easel.inbox.message.multiple_elements_instances\":\"A Payment Element integration uses an Elements instance to manage a group of elements. When using the Payment Element with other elements—such as the Address Element or Express Checkout Element—create all elements within the same Elements instance for optimal performance.\",\"easel.inbox.message.checkout_session_pricing_usage\":\"Use the amount and currency provided by your Checkout Session when displaying total and line-item prices. This will ensure consistency and proper localization.\",\"easel.inbox.message.dynamic_payment_method\":\"Use dynamic payment methods to automatically display the most relevant eligible payment methods to each customer to maximize conversion.\",\"easel.inbox.message.currency_selector_element\":\"Add the Currency Selector Element to your page so your international customers will have full control over their choice in currency and payment method.\",\"easel.inbox.no_issues_detected\":\"No issues detected\",\"easel.inbox.view_docs\":\"View docs\",\"easel.inbox.view_migration_guide\":\"View migration guide\",\"easel.presets.address_element.heading\":\"Address Element presets\",\"easel.presets.address_element.valid_address\":\"Valid address\",\"easel.presets.tax_id_element.heading\":\"Tax ID Element presets\",\"easel.presets.tax_id_element.valid_tax_id\":\"Valid tax ID\",\"easel.presets.tax_id_element.invalid_tax_id\":\"Invalid tax ID\",\"easel.presets.link_authentication_element.valid_email\":\"Valid email\",\"easel.presets.magic_fill\":\"Magic fill\",\"easel.presets.magic_fill.description\":\"Instantly fill all fields in your Elements with valid data.\",\"easel.presets.none.heading\":\"No presets available\",\"easel.presets.none.description\":\"Mount Payment Element or Address Element to use presets.\",\"easel.presets.payment_element.heading\":\"Payment Element presets\",\"easel.presets.payment_element.other_heading\":\"Other Payment Element presets\",\"easel.presets.payment_element.all_methods\":\"All payment methods\",\"easel.presets.payment_element.preset.heading\":\"{formName} presets\",\"easel.presets.payment_element.preset.displayed_subheading\":\"Displayed\",\"easel.presets.payment_element.preset.all_button\":\"All {formName} presets\",\"easel.presets.payment_element.preset.docs_description\":\"See more testing options and other resources for this payment method in our docs.\",\"easel.presets.payment_element.preset.view_docs\":\"{formName} docs\",\"easel.presets.payment_element.3ds2_required_card\":\"3DS2 required card\",\"easel.presets.payment_element.declined_card\":\"Declined card\",\"easel.presets.payment_element.fraudulent_card\":\"Fraudulent card\",\"easel.presets.payment_element.successful_card\":\"Successful card\",\"easel.presets.payment_element.successful_preset\":\"Successful\",\"easel.presets.payment_element.failure_preset\":\"Failure\",\"easel.presets.payment_element.valid_preset\":\"Valid\",\"easel.presets.payment_element.invalid_preset\":\"Invalid\",\"easel.presets.payment_element.successful_debit\":\"Successful\",\"easel.presets.payment_element.short_delay_successful_debit\":\"Successful after 15 seconds\",\"easel.presets.payment_element.delay_successful_debit\":\"Successful after 3 minutes\",\"easel.presets.payment_element.failure_not_authorized\":\"Fails with debit not authorized\",\"easel.presets.payment_element.delay_failure_not_authorized\":\"Fails after 3 minutes with debit not authorized\",\"easel.presets.payment_element.failure_insufficient_funds\":\"Fails with insufficient funds\",\"easel.presets.payment_element.delay_failure_insufficient_funds\":\"Fails after 3 minutes with insufficient funds\",\"easel.presets.payment_element.delay_account_dispute\":\"Successful after 3 minutes then creates a dispute\",\"easel.presets.payment_element.account_dispute\":\"Successful then creates a dispute\",\"easel.presets.payment_element.mandate_refused\":\"Mandate is refused by customer\\'s bank\",\"easel.presets.payment_element.invalid_account\":\"Invalid account number\",\"easel.presets.payment_element.exceeds_source_limit\":\"Fails with charge exceeds source limit\",\"easel.presets.payment_element.exceeds_weekly_limit\":\"Fails with charge exceeds weekly limit\",\"easel.presets.payment_element.exceeds_transaction_limit\":\"Fails with charge exceeds transaction limit\",\"easel.presets.payment_element.failure_account_closed\":\"Fails with account closed\",\"easel.presets.payment_element.failure_refer_to_customer\":\"Fails with refer to customer\",\"easel.presets.payment_element.delay_failure_refer_to_customer\":\"Fails after 3 minutes with refer to customer\",\"easel.presets.payment_element.delay_failure_no_account\":\"Fails with no account\",\"easel.presets.payment_element.payment_method_not_available\":\"Fails with payment method not available\",\"easel.presets.payment_element.provider_decline\":\"Fails with provider declined\",\"easel.presets.payment_element.payment_attempt_expired\":\"Fails with payment attempt expired\",\"easel.presets.payment_element.customer_decline\":\"Fails with customer declined\",\"easel.presets.payment_element.requires_payment_method\":\"Fails with requires payment method\",\"easel.presets.payment_element.delay_requires_payment_method\":\"Fails after 3 minutes with requires payment method\",\"easel.presets.payment_element.fail_risk_check\":\"Fraudulent customer\",\"easel.presets.payment_element.early_expiry\":\"Expires 2 days after confirmation\",\"easel.presets.payment_element.remains_processing\":\"Transitions to processing and remains there\",\"easel.presets.payment_element.delay_processing_success\":\"Transitions to processing after 20 seconds, then succeeded after 2 seconds\",\"easel.presets.payment_element.delay_invalid_authorization\":\"Declined after 20 seconds with invalid authorization\",\"easel.presets.payment_element.fail_timeout\":\"Declined after 1 minute with provider timeout\",\"easel.presets.payment_element.delay_processing_insufficient_funds\":\"Transitions to processing after 20 seconds, then is declined with insufficient funds\",\"easel.presets.payment_element.delay_inactive\":\"Declined after 20 seconds with inactive mandate\",\"easel.presets.view_all\":\"All presets\",\"easel.presets.availability\":\"{numAvailable} available\",\"easel.presets.view_docs\":\"View docs\",\"easel.settings.clear_button.label\":\"Clear\",\"easel.settings.about.description\":\"We built this widget to give developers helpful shortcuts, testing tools, and timely guidance when integrating Stripe Elements into their checkout pages. It only shows in development—your customers should never see it.\",\"easel.settings.about.description.link_text\":\"How to disable\",\"easel.settings.about.heading\":\"About this tool\",\"easel.settings.feedback.heading\":\"Send us feedback\",\"easel.settings.feedback.input_label\":\"Share your thoughts\",\"easel.settings.feedback.input_description\":\"We\\'d love to improve our product and hear your feedback.\",\"easel.settings.feedback.input_placeholder\":\"Feedback\",\"easel.settings.feedback.input_error\":\"Message cannot be blank.\",\"easel.settings.feedback.can_followup\":\"Allow Stripe to follow up\",\"easel.settings.feedback.email_label\":\"Email\",\"easel.settings.feedback.email_placeholder\":\"you@example.com\",\"easel.settings.feedback.email_empty_error\":\"Email cannot be blank.\",\"easel.settings.feedback.email_invalid_error\":\"Please provide a valid email address.\",\"easel.settings.feedback.submit_button\":\"Submit\",\"easel.settings.feedback.thank_you\":\"Thank you for your feedback!\",\"easel.settings.key_mode.live\":\"Live mode\",\"easel.settings.key_mode.test\":\"Sandbox\",\"easel.settings.key_mode.unknown\":\"Unknown mode\",\"easel.settings.position.heading\":\"Position\",\"easel.settings.session_summary.account_id\":\"Account ID\",\"easel.settings.session_summary.account_id.copy\":\"Copy Account ID: {copyValue}\",\"easel.settings.session_summary.account_id.copied\":\"Account ID copied to clipboard\",\"easel.settings.session_summary.session_id\":\"Session ID\",\"easel.settings.session_summary.session_id.copy\":\"Copy Session ID: {copyValue}\",\"easel.settings.session_summary.session_id.copied\":\"Session ID copied to clipboard\",\"easel.settings.session_summary.stripe_js_id\":\"Stripe.js ID\",\"easel.settings.session_summary.stripe_js_id.copy\":\"Copy Stripe.js ID: {copyValue}\",\"easel.settings.session_summary.stripe_js_id.copied\":\"Stripe.js ID copied to clipboard\",\"easel.test.elements_inspector\":\"Elements inspector\",\"easel.test.elements_inspector.action_description\":\"View payment method availability and integration status for any customer country.\",\"easel.test.location.action_description\":\"Preview how customers in other countries will see your Elements.\",\"easel.test.location.country_select.disabled\":\"Available only when using Adaptive Pricing.\",\"easel.test.location.country_select.label\":\"Customer country\",\"easel.test.location.feature_list.ap.description\":\"Prices for your line items and cart total should update to the customer’s local currency.\",\"easel.test.location.feature_list.ap.link_text\":\"About Adaptive Pricing\",\"easel.test.location.feature_list.description\":\"Here’s what to look for as you update the customer country, based on available Stripe features:\",\"easel.test.location.feature_list.dpm.description\":\"Local payment methods relevant to the customer should be made available.\",\"easel.test.location.feature_list.dpm.link_text\":\"About dynamic payment methods\",\"easel.test.location.feature_list.tax_id.description\":\"Tax ID Element presets should update to match the customer\\'s country tax requirements.\",\"easel.test.location.feature_list.tax_id.link_text\":\"About tax ID collection\",\"easel.test.location\":\"Test customer location\",\"easel.warning.ae.autocomplete.using_stripe_api_key\":\"It looks like you\\'re using a Stripe key for Address Element autocomplete. Please use your Google Maps API key instead. You can setup the key follow the instructions below.\",\"easel.warning.ae.contacts.invalid_country\":\"Invalid value provided for <code>contacts[{contactIndex}].address.country</code>; \\\\\"{country}\\\\\" is not a valid 2-letter country code.\",\"easel.warning.ae.default_values.invalid_country\":\"Invalid value provided for <code>address.country</code>; \\\\\"{country}\\\\\" is not a valid 2-letter country code.\",\"easel.warning.ae.default_values.not_in_allowed_countries\":\"Invalid value provided for <code>address.country</code>; \\\\\"{country}\\\\\" is not in <code>allowedCountries</code>.\",\"easel.warning.ece.frame_error\":\"An error occurred loading the <code>{paymentMethodType}</code> button.\",\"easel.warning.pe.fields.billing_details_never_with_default_values\":\"Passing \\\\\"never\\\\\" for <code>fields.billingDetails</code> in combination with <code>defaultValues.billingDetails</code> is not recommended. Instead pass <code>billing_details</code> when creating the payment method or confirming the payment.\",\"easel.warning.sjs.https_warning\":\"You may test your Stripe.js integration over HTTP. However, live Stripe.js integrations must use HTTPS.\",\"easel.warning.ewcs.legacy_subscription_warning\":\"Your Checkout Session is using an older API version. Please upgrade to <code>2025-03-31.basil</code> or above to reduce latency by 5-10% on a